<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    本地模块的 manifest 会在 Gradle 构建时自动 merge 进主工程的 AndroidManifest.xml，
    所以这里注册 Service 就够了，不需要额外写 config plugin。

    注意：<service> 必须嵌在 <application> 内部，直接挂在 <manifest> 下会触发
    AAPT "unexpected element <service> found in <manifest>"。

    BIND_NOTIFICATION_LISTENER_SERVICE 是「签名级」权限，无法用 requestPermissions 动态申请，
    只能由用户在「设置 → 通知使用权」里手动授权；因此它以 android:permission 的形式声明在
    service 上，而不是写成 uses-permission。
  -->

  <!-- 悬浮窗（显示在其他应用上层）。属于「特殊权限」，声明后仍需用户去系统设置里手动打开 -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

  <!-- 捕获后弹通知（Android 13+ 需要运行时授权） -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- 银行动账短信（运行时权限，用户可在设置页开启） -->
  <uses-permission android:name="android.permission.RECEIVE_SMS" />
  <uses-permission android:name="android.permission.READ_SMS" />

  <application>
    <service
      android:name="expo.modules.notificationlistener.TransactionNotificationService"
      android:label="通知监听"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

    <!--
      读屏服务：仅在用户手动开启「无障碍」后生效。
      BIND_ACCESSIBILITY_SERVICE 同样是签名级权限，必须用户去系统设置里授权。
      事件范围已在 xml 配置里限定为微信/支付宝两个包。
    -->
    <service
      android:name="expo.modules.notificationlistener.ReceiptAccessibilityService"
      android:label="读屏自动记账"
      android:exported="true"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/notification_listener_accessibility_config" />
    </service>

    <!-- 通知里的分类按钮 -->
    <receiver
      android:name="expo.modules.notificationlistener.CategoryFixReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="expo.modules.notificationlistener.CATEGORY_FIX" />
      </intent-filter>
    </receiver>

    <!--
      银行短信广播。android:permission 保证只有系统（广播发送方）能触发，
      普通应用无法伪造一条「短信到达」广播。
    -->
    <receiver
      android:name="expo.modules.notificationlistener.BankSmsReceiver"
      android:exported="true"
      android:permission="android.permission.BROADCAST_SMS">
      <intent-filter android:priority="999">
        <action android:name="android.provider.Telephony.SMS_RECEIVED" />
      </intent-filter>
    </receiver>
  </application>

</manifest>
